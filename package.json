{
  "name": "bitswarm",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "check": "tsc --noEmit",
    "swarm": "bun src/cli.ts",
    "demo": "bun examples/demo.ts",
    "benchmark": "bun examples/benchmark.ts",
    "agent": "bun examples/llm-adapter.ts",
    "format": "prettier --write src tests examples docs README.md package.json tsconfig.json .github/workflows/ci.yml",
    "format:check": "prettier --check src tests examples docs README.md package.json tsconfig.json .github/workflows/ci.yml",
    "test:isolation": "BITSWARM_TEST_ISOLATION=1 bun test tests/isolation.test.ts",
    "test:integration": "BITSWARM_TEST_ISOLATION=1 BITSWARM_TEST_LAN=1 bun test",
    "benchmark:live": "bun examples/live/run.ts",
    "benchmark:baseline": "BITSWARM_BASELINE=1 bun examples/live/run.ts",
    "stress": "bun examples/stress.ts",
    "agent:codex": "bun examples/codex-adapter.ts",
    "benchmark:compatibility": "bun examples/compatibility/run.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@libp2p/autonat": "^3.0.32",
    "@libp2p/circuit-relay-v2": "^4.2.17",
    "@libp2p/crypto": "^5.2.0",
    "@libp2p/dcutr": "^3.0.32",
    "@libp2p/identify": "^4.1.18",
    "@libp2p/interface": "^3.4.0",
    "@libp2p/kad-dht": "^16.4.9",
    "@libp2p/mdns": "^12.0.36",
    "@libp2p/ping": "^3.1.17",
    "@libp2p/tcp": "^11.0.32",
    "@multiformats/multiaddr": "^13.0.3",
    "ajv": "^8.20.0",
    "libp2p": "^3.5.1",
    "multiformats": "^14.0.5"
  }
}
